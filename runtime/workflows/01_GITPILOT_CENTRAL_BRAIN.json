    {
      "parameters": {
        "jsCode": "const body=$json.body??$json;\nconst action=body.action || body.intent || 'analyze';\nconst allowed=['analyze','discover','plan','execute','approve','review'];\nif(!allowed.includes(action)) throw new Error(`Unsupported action: ${action}`);\nconst taskId=body.taskId || `task_${Date.now()}_${Math.random().toString(36).slice(2,10)}`;\nreturn [{json:{...body, action, taskId, state: action==='execute'?'AWAITING_APPROVAL':'RECEIVED', idempotencyKey:body.idempotencyKey||taskId, receivedAt:new Date().toISOString()}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "c6dca1e0-c7b0-5c09-8f30-f11826949ac3",
      "name": "Normalize request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        300,
        0
      ],
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tasks (id, user_id, state, input_json, idempotency_key) VALUES ({{$json.taskId}}, {{$json.userId}}, {{$json.state}}, $json::jsonb, {{$json.idempotencyKey}}) ON CONFLICT (id) DO UPDATE SET updated_at=now() RETURNING *;",
        "options": {}
      },
      "id": "9db82397-71c2-56ea-82a3-3afdafd0e24b",
      "name": "Persist task state",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        760,
        0
      ],
      "onError": "stopWorkflow",
      "credentials": {
        "postgres": {
          "id": "GitPilot PostgreSQL",
          "name": "GitPilot PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst destructive=['execute','approve'].includes(x.action);\nif (destructive && x.approvalStatus !== 'APPROVED') return [{json:{...x,state:'AWAITING_APPROVAL',approvalRequired:true,message:'Explicit approval is required before external changes.'}}];\nreturn [{json:{...x,state:x.state||'ANALYZING',approvalRequired:false}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "b042c5ad-42e7-5afe-a154-3a3e6c3ec67a",
